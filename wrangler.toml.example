name = "sholat-bot"
main = "src/index.ts"
compatibility_date = "2026-01-07"

[triggers]
crons = ["* * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "sholat_bot_db"
database_id = "PASTE_YOUR_DATABASE_ID_HERE"

[vars]
TELEGRAM_API_BASE = "https://api.telegram.org"
NOMINATIM_USER_AGENT = "SholatBot/1.0 (contact: your-email@example.com)"
